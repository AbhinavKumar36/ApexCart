rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Users collection rules
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isAdmin() || (isAuth() && request.auth.uid == userId);
    }

    // Products collection rules
    match /products/{productId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Sales collection rules
    match /sales/{saleId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAdmin(); // only admins can refund/void or edit sales
    }

    // Settings collection rules
    match /settings/{settingId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Suppliers collection rules
    match /suppliers/{supplierId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Purchase Orders collection rules
    match /purchaseOrders/{poId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Activity Logs collection rules
    match /activityLogs/{logId} {
      allow read: if isAdmin(); // only admins can read audit logs
      allow create: if isAuth(); // cashiers and admins can log actions
      allow update, delete: if false; // activity logs are read-only once written
    }

    // Expenses collection rules
    match /expenses/{expenseId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
  }
}
